{
  "name": "retro-cabinet",
  "version": "1.3.0",
  "type": "module",
  "imports": {
    "#root/*.js": "./*.js"
  },
  "scripts": {
    "build": "node tools/builder/builder.js",
    "build:prod": "node tools/builder/builder.js --prod",
    "typecheck": "node tools/builder/builder.js --typecheck",
    "serve": "node tools/builder/builder.js && node tools/dev/serve.js",
    "serve:only": "node tools/dev/serve.js",
    "serve:prod": "node tools/builder/builder.js --prod && node tools/dev/serve.js",
    "dev": "node tools/dev/dev-serve.js",
    "generate": "node tools/generator/generator.js",
    "testin-nutin": "node tools/builder/builder.js && node tools/testin-nutin/runner.js",
    "testin-nutin:only": "node tools/testin-nutin/runner.js",
    "testin-nutin:watch": "node tools/builder/builder.js && node tools/testin-nutin/watch-tests.js",
    "testin-nutin:coverage": "node tools/builder/builder.js && node tools/testin-nutin/runner.js --coverage",
    "testin-nutin:verbose": "node tools/builder/builder.js && node tools/testin-nutin/runner.js --verbose",
    "docker:build": "node tools/docker/scripts/docker-build.js",
    "docker:run": "node tools/docker/scripts/docker-run.js"
  },
  "devDependencies": {
    "chokidar": "^6.0.0",
    "esbuild": "^0.28.2",
    "html-minifier-terser": "^7.2.0",
    "jsdom": "^31.0.1",
    "linkedom": "^0.18.15",
    "sass": "^1.108.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "a11y-elements": "^1.0.2"
  }
}
